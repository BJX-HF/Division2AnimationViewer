class Projectile
{
	file myTracer ""
	AudioEvent myHitAudioEvent
	AudioEvent myHitAudioSweetenerEvent
	AudioEvent myWhizzAudioEvent
	file myHitEffect ""
	file myPointCloudHitEffect "rogue/graph objects/effect/echo_bullet_interference_fx.mgraphobject"
	uid myPointCloudHitAudioEvent 4A75D5CDFDF375F22ECC06A2E677B0BA < bhv=AudioID type=Event > 
	float myHitEffectSize 0 < min=0 max=1 >
	bool myHasImpactShockwave false
}

