list FireEventList
{
	FireEvent
}

class WeaponDamage
{
	DamageInfoList myDamages
	
	float myRangeOptimal 50.0 < tooltip="The weapon does (max damage +- variation) up to this range" >
	float myRangeLong 75.0 < tooltip="The weapon does (min damage +- variation) above this range" >
	float myRangeMax 100.0 < tooltip="The weapon does 0 damage above this range" >
	
	float mySkillScriptDamage 0.0 < tooltip="The damage that can be applied to weapon associated skillscripts." >

	bool myUsePVPOverrides FALSE < tooltip="If this is true, the PvP values below will be used whenever an agent attacks another with this weapon." >	
	float myPvPDamageMin 10.0 < tooltip="The minimum damage the weapon will inflict above PvP Long Range whenever an agent attacks another" >
	float myPvPDamageMax 20.0 < tooltip="The maximum damage the weapon will inflict up to PvP Optimal Range whenever an agent attacks another" >
	float myPvPRangeOptimal 50.0 < tooltip="The weapon does (pvp max damage +- variation) up to this range whenever an agent attacks another" >
	float myPvPRangeLong 75.0 < tooltip="The weapon does (pvp min damage +- variation) above this range whenever an agent attacks another" >
	float myPVPDamageModifier 1.0 < tooltip="Multiplier that modifies how much damage is done when one agent attacks another" >
	
	float myCriticalHitChance 0.0 < tooltip="The chance each bullet will cause a critical hit" >
	float myCriticalHitChanceDistanceMin 0.0 < tooltip="The minimum distance at which a bullet can cause a critical hit" >
	float myCriticalHitChanceDistanceMax 100.0 < tooltip="The maximum distance at which a bullet can cause a critical hit" >
	float myCriticalHitDamageModifier 1.0 < tooltip="Multiplier for the damage caused by a critical hit" >
	
	float myCoverDamageMin 100.0 < tooltip="The minimum damage the weapon will inflict to covers above Long Range" >
	float myCoverDamageMax 200.0 < tooltip="The maximum damage the weapon will inflict to covers up to Optimal Range" >
	float myCoverDamageVariation 15.0 < tooltip="The added random damage (ranges from -Variation to +Variation) the weapon will inflict at any range up to Max Range to covers" >
	
	float myDamageMultiplierHead 1.4 < tooltip="Damage multiplier for the Head hitbox area" >
	float myDamageMultiplierBody 1.0 < tooltip="Damage multiplier for the Body hitbox area" >
	float myDamageMultiplierArms 1.0 < tooltip="Damage multiplier for the Arms (Left + Right) hitbox area" >
	float myDamageMultiplierLegs 1.0 < tooltip="Damage multiplier for the Legs (Left + Right) hitbox area" >
	
	float myStaggerDamageModifier 1.0 < tooltip="Multiplier that modifies how much stagger is done" >
}

class FireEventWeaponOverride
{
	int myRPM 500 < tooltip="Rounds Fired Per Minute" >
	int myRPMFluctuationMin 0 < max=0 tooltip="Fluctuating value removed from RPM randomly, has to be negative." >
	int myRPMFluctuationMax 0 < min=0 tooltip="Fluctuating value added to RPM randomly, has to be positive." >

	bool myUsePVPOverrides FALSE < tooltip="If this is true, the PvP values below will be used whenever an agent attacks another with this weapon." >
	int myPvPRPM 0 < min=0 tooltip="PvP override for rounds per minute. 0 means use the base RPM." >
	int myPvPRPMFluctuationMin 0 < max=0 tooltip="PvP override for fluctuating value removed from RPM randomly, has to be negative." >
	int myPvPRPMFluctuationMax 0 < min=0 tooltip="PvP override for fluctuating value added to RPM randomly, has to be positive." >

	WeaponDamage myDamage
}

list FireEventWeaponOverrideComponent < size=1 >
{
	FireEventWeaponOverride
}

class FireEvent < abstract=1 >
{
	ProjectileData myProjectileData
	WindUpConfig myWindUpConfig
	int myBulletsPerRound 1 < tooltip="Number of bullets fired at the same time" >
	SkillScript* myImpactSkillScript
	SkillScript* myTrajectorySkillScript
	SkillScript* myProjectileSkillScript
	int myLifetimeAfterImpact 0 < min=0 max=5000 tooltip="How long the graph object stays alive after impact in ms. MAX 5000">
	FireEventDeployType myDeployType Equip < tooltip="Quick deploy allows for this impact script to be quick deployed and used without equipping the weapon first." >
	ItemModTag myModTag Invalid
	bool myCausesSparks TRUE < tooltip="If true, the fire event causes sparks in the projectile source." >
	bool myCausesDetectionHit TRUE < tooltip="The impact of this fire event will cause NPCs to notice the shooter.">
	AudioBank myLocalPlayerBank
	AudioBank myLocalPlayerTailsBank
	InputWeaponConfigList myInputConfig
	SkillWeaponConfigList mySkillConfig
	FireEventWeaponOverrideComponent myWeaponOverride
}

class FullAutoFireEvent : FireEvent
{
	string myAnimationLayer "Burst"
	AudioEvent myStartAudioEvent
	AudioEvent myEndAudioEvent
	int myNumPSPRounds 2 < tooltip="Play-Stop-Play value.  If greater than 0, this will cause this number of single shots to be fired before starting the loop." >
}

class BurstFireEvent : FireEvent
{
	string myAnimationLayer "Burst"
	AudioEvent myStartAudioEvent
	AudioEvent myEndAudioEvent
	int myRoundsPerBurst 3 < tooltip="Number of bullets fired during a burst " >
	int mySequenceBurstsPerMin 60 < tooltip="Number of bursts per minute under sequence control" >
	int myBurstRPMOverride 0 < tooltip="If set it overrides the default RPM during using that fire mode" >
}

class SemiAutoFireEvent : FireEvent
{
	string myAnimationLayer "Fire"
	AudioEvent myAudioEvent
}

class SkillScriptFireEvent : FireEvent
{
	ProjectileData myProjectileData < hidden=1 >
	string myAnimationLayer "Fire"
	AudioEvent myAudioEvent
}

class ThrowableFireEvent : FireEvent
{
	ThrowableItemType myThrowableItemConfigType None < tooltip="If the weapon is throwable, it'll fetch the throwable item config corresponding to this type. See throwableitemconfig juice." >
	ProjectileData myProjectileData < hidden=1 >
	string myAnimationLayer "Throw"
	AudioEvent myAudioEvent < tooltip="Use this audio event as OnThrow." >
	AudioEvent myOnBounceAudioEvent
	AudioEvent myOnLandedAudioEvent
	bool myCausesSparks FALSE
	QuickThrowConfigList myQuickThrowConfig
}

class BinaryFireEvent : FireEvent
{
	string myAnimationLayer "Fire"
	AudioEvent myAudioEvent
}

class ChargedFireEvent : FireEvent
{
	string myAnimationLayer "Fire"
	AudioEvent myAudioEvent
	float myMaxDuration 5.0 < tooltip="Time in seconds after which this event will automatically fire." >
}

class AdditionalAudioEvent
{
	AudioEvent myStartAudioEvent
	AudioEvent myEndAudioEvent
	AudioBank myNPCAndRemotePlayerBank
}

list AdditionalAudioEventList
{
	AdditionalAudioEvent
}

class AdditionalAudioEvents
{	
	AdditionalAudioEventList myAdditionalSingleAudioEvents
	AdditionalAudioEventList myAdditionalMultiAudioEvents
}

class WeaponFeedback
{
	Projectile myProjectile
	
	AudioEvent myReloadAudioEvent ""
	AudioEvent myOutOfAmmoClickAudioEvent ""
	AudioEvent myOutOfAmmoWarningAudioEvent ""
	int myOutOfAmmoWarningStart 5 < tooltip="When the weapon clip ammo count is less than or equal to this value, the out of ammo click events will trigger each time a shot is fired." >
	float myWeaponJamFactor 0.0 < min=0.0 max=100.0 tooltip="A value between 0.0 and 100.0 that defines the weapons jam factor." >
}

class AimAssist
{
	float myInnerAttractorBoxWidth 1.1 < tooltip="The unmodified width of the inner, full strength, attractor." >
	float myInnerAttractorBoxHeight 0.8 < tooltip="The unmodified height of the inner, full strength, attractor." >
	float myOuterAttractorBoxWidth 1.8 < tooltip="The unmodified width of the outer attractor, at the edge of which the distance fade starts" >
	float myOuterAttractorBoxHeight 1.5 < tooltip="The unmodified height of the outer attractor, at the edge of which the distance fade starts" >
	
	float myTargetAngleVersusDistanceScore 1.5 < tooltip="Modifies how much angle to target is worth versus distance to target when picking aim assist target. Higher value means angle has bigger impact." >
	
	float mySnapBoxWidth 1.0 < tooltip="The width of box within which snap is applied" >
	float mySnapBoxHeight 1.0 < tooltip="The height of box within which snap is applied" >
	float mySnapOffsetLimit 0.55 < tooltip=" The height of the box within which the pitch is maintained when snapping. The width of this box is mySnapBoxWidth" >
	
	float mySnapAttractorStrength 0.03 < tooltip="The strength of snapping" >
	float myAimAttractorStrength 0.80 < tooltip="The maximum part of the aim input removed by aim assist" >
	float myMovementAttractorStrength 0.75 < tooltip="How big a part of the angle change to target caused by moving the player character is removed? 1.0 = lock on if not actively aiming and target not moving" >
	
	float myAimAttractorAdditionInZoom 0.0 < tooltip="How does the strength of the aim attractor change when zoomed in?" >
	float myCatchupHelpStrength 0.0 < tooltip="How far towards the center can the inner attractor edge be moved to help correct movements in reaching the target? 1.0 = to the center" >
	
	float mySnapDuration 1.0 < tooltip="For how long is snap applied" >
	string mySnapCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { 0 0, -0.06495 0.000302, -0.689434 0.022612, }, outTangents = { 0.272497 0, 0.584549 0, 0 0, }, properties = { 275, 2323, 1299, }, values = { 0 1, 0.2 1, 1 0, }, }, numKeys = 3, }" < bhv=inputgraph tooltip="Snapping multiplier over time (x=1 is mySnapDuration)">
	float myKillSnapInputLength 0.95 < tooltip="At what input length is aim snap always immediately canceled" >
	float mySnapGrippyness 1.0 < tooltip="To what extent is input canceling of small imputs applied at the beginning of the snap (0 = none)" >
	
	float myDistance 0.0 < tooltip="At what distance are these settings authorotative (used to blend between settings)" >
}

class LockAimData
{
	float myTrackIdleTargetSpringStrength 400.f
	float myTrackMovingTargetSpringStrength 700.f
	float myAimingSpringStrength 250.f
	float myAimingBaseSpeed 7.0
	float myMaxTargetRayDistToTestCamDist 0.2f
	vec2f myLockSnapBox 0.8;0.8
	vec2f mySnapToTargetBox 2.8;1.8
	vec3f myCenterOffset 0.0;0.25;0.0
	string myCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, keys2 = { inTangents = { -0 -0, -0.369897 -0.096132, }, outTangents = { 3.24613 0.014325, 0 0, }, properties = { 275, 1299, }, values = { 0 0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph >
}

class CameraData
{
	string myAimAssistTimeFadeCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.7 -0.0, }, outTangents = { 0.4 0.0, 0 0, }, properties = { 275, 1299, }, values = { 0 0.0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph  tooltip="The fade multiplier over time (x=1 is myAimAssistFadeTime)">
	string myAimAssistDistanceFadeCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.3 -0.0, }, outTangents = { 0.5 0.0, 0 0, }, properties = { 275, 1299, }, values = { 0 0.0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph  tooltip="The fade multiplier between the outer and inner attractor">
	string myAimAssistMinMidBlendCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.2 -0.0, }, outTangents = { 0.9 0.0, 0 0, }, properties = { 275, 1299, }, values = { 0 0.0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph  tooltip="Blend from min(0) to mid (1) settings">
	string myAimAssistMidMaxBlendCurve "{ defaultLeftSlope = 0, defaultRightSlope = 0, defaultValue = 0, interpolator = 0, isRefinedSampling = true, keys2 = { inTangents = { -0 -0, -0.5 -0.0, }, outTangents = { 0.2 0.00, 0 0, }, properties = { 275, 1299, }, values = { 0 0.0, 1 1, }, }, numKeys = 2, }" < bhv=inputgraph  tooltip="Blend from mid(0) to max (1) settings">
	float myAimAssistFadeTime 2.0 < tooltip="The time the aim assist lingers after a target dies or disappears" >
	float myAimAssistCutDistance 1000.0 < tooltip="The distance to target beyond which aim assist is no longer applied" >
	AimAssist myAimAssistMinValues < tooltip="Aim assist at minimum distance" >
	AimAssist myAimAssistMidValues < tooltip="Aim assist at middle distance" >
	AimAssist myAimAssistMaxValues < tooltip="Aim assist at maximumdistance" >
	LockAimData myLockAimData
	float myFiringNotAimingCameraSpeedModifier 1.0
	float myFiringAimingCameraSpeedModifier 1.0
}

