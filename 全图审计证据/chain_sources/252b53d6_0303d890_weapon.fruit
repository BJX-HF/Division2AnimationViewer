class Weapon < uid=auto >
{
	float myDamageMin 10.0 < tooltip="The minimum damage the weapon will inflict above Long Range" >
	float myDamageMax 20.0 < tooltip="The maximum damage the weapon will inflict up to Optimal Range" >
	float myDamageVariation 5.0 < tooltip="The added random damage (ranges from -Variation to +Variation) the weapon will inflict at any range up to Max Range" >
	DamageInfoList myDamages
	float mySkillScriptDamage 0.0 < tooltip="The damage that can be applied to weapon associated skillscripts." >

	bool myUsePVPOverrides FALSE < tooltip="If this is true, the PvP values below will be used whenever an agent attacks another with this weapon." >
	float myPvPDamageMin 10.0 < tooltip="The minimum damage the weapon will inflict above PvP Long Range whenever an agent attacks another" >
	float myPvPDamageMax 20.0 < tooltip="The maximum damage the weapon will inflict up to PvP Optimal Range whenever an agent attacks another" >
	float myPvPRangeOptimal 50.0 < tooltip="The weapon does (pvp max damage +- variation) up to this range whenever an agent attacks another" >
	float myPvPRangeLong 75.0 < tooltip="The weapon does (pvp min damage +- variation) above this range whenever an agent attacks another" >
	int myPvPRPM 0 < min=0 tooltip="PvP override for rounds per minute. 0 means use the base RPM." >
	int myPvPRPMFluctuationMin 0 < max=0 tooltip="PvP override for fluctuating value removed from RPM randomly, has to be negative." >
	int myPvPRPMFluctuationMax 0 < min=0 tooltip="PvP override for fluctuating value added to RPM randomly, has to be positive." >
	int myPvPReloadTimeMS 0 < min=0 tooltip="PvP override for reload time in milliseconds. 0 means use the base reload time." >
	int myPvPEmptyClipFirstRoundReloadTimeMS -1 < min=-1 tooltip="Unique reload time for first reload cycle after emptying the clip. Using a negative value will make it use the PvE value." >

	int mySuppressionValue 10 < tooltip="The suppression effect of this weapon when shooting at NPCs" >
	
	float myCriticalHitChance 0.0 < tooltip="The chance each bullet will cause a critical hit" >
	float myCriticalHitChanceDistanceMin 0.0 < tooltip="The minimum distance at which a bullet can cause a critical hit" >
	float myCriticalHitChanceDistanceMax 100.0 < tooltip="The maximum distance at which a bullet can cause a critical hit" >
	float myCriticalHitDamageModifier 1.0 < tooltip="Multiplier for the damage caused by a critical hit" >
		
	float myCoverDamageMin 100.0 < tooltip="The minimum damage the weapon will inflict to covers above Long Range" >
	float myCoverDamageMax 200.0 < tooltip="The maximum damage the weapon will inflict to covers up to Optimal Range" >
	float myCoverDamageVariation 15.0 < tooltip="The added random damage (ranges from -Variation to +Variation) the weapon will inflict at any range up to Max Range to covers" >
	
	float myPhysicalImpulse 6.0 < tooltip="Physical impulse from bullet on hitobject (kg*m/s)" >
	
	float myDamageMultiplierHead 1.4 < tooltip="Damage multiplier for the Head hitbox area" >
	float myDamageMultiplierBody 1.0 < tooltip="Damage multiplier for the Body hitbox area" >
	float myDamageMultiplierArms 1.0 < tooltip="Damage multiplier for the Arms (Left + Right) hitbox area" >
	float myDamageMultiplierLegs 1.0 < tooltip="Damage multiplier for the Legs (Left + Right) hitbox area" >

	float myPiercingMultiplier 0.0 < tooltip="Piercing value, should be used to calculate final defence" >
	
	float myRangeOptimal 50.0 < tooltip="The weapon does (max damage +- variation) up to this range" >
	float myRangeLong 75.0 < tooltip="The weapon does (min damage +- variation) above this range" >
	float myRangeMax 100.0 < tooltip="The weapon does 0 damage above this range" >
	
	int myRPM 500 < tooltip="Rounds Fired Per Minute" >
	int myRPMFluctuationMin 0 < max=0 tooltip="Fluctuating value removed from RPM randomly, has to be negative." >
	int myRPMFluctuationMax 0 < min=0 tooltip="Fluctuating value added to RPM randomly, has to be positive." >
	
	float myAimDistanceDefault 30.0 < tooltip="The default focus distance while aiming" >
	float myAimDistanceMax 100.0 < tooltip="Maximum focus distance " >
	
	float myShootThroughCornersDistance -1.0 < tooltip="" >
	bool myShouldShootThroughCornersInCover TRUE < tooltip="" >
	
	RecoilProfile* myCameraRecoil 
	RecoilProfile* myAimDirectionRecoil 
	
	WeaponReloadTypes myReloadType Magazine
	int myRoundsAddedPerReload -1 < tooltip="If left at -1 (default) it will cause the weapon to reload normally (fill the entire clip after reload is complete). If set anything above 0, each reload session will fill the clip by the amount set for the variable" >
	int myClipSize -1 < tooltip="Clip size of the weapon" >
	int myReloadTimeMS 800 < tooltip="Reload timer for the weapon" >
	int myEmptyClipFirstRoundReloadTimeMS -1 < min=-1 tooltip="Unique reload time for first reload cycle after emptying the clip. Using a negative value will disable this option" >
	int myInitialShellReloadTimeMS -1 < min=-1 tooltip="Reload time for the first shell in a reload cycle. Negative values disables this for the weapon." >
	int myEndReloadTimeMS -1 < min=-1 tooltip="Reload time for the ending of a reload cycle (last shell in a shotgun needing a pumping motion or so). Negative values disables this for the weapon." >
	int myAutoReloadDelayMS 0 < min=0 tooltip="Adds a delay between firing the final round in the current clip and beginning the reload sequence" >
	bool myForcePreventRoundInChamber FALSE < tooltip="If this is set to true, we will prevent a round from being in the chamber on reload (+1 round when reloading not from empty), regardless of the reload type (normally we allow a round in the chamber if the reload type is Magazine)." >
	bool myHasUnlimitedAmmo false < tooltip="If checked the weapon has unlimited spare ammo" >

	file myGraphObject "" < bhv=asset assettype=object >
	file myMagazineGraphObject "" < bhv=asset assettype=object >
	file myInventoryIcon ""
	file myCrosshairUIGraph "hunter/ui/graphs/crosshair_default.muigraph" < bhv=asset assettype=gui >

	file myDefaultTextureDiffuse ""
	file myDefaultTextureNormal ""
	file myDefaultTextureMaterial ""

	FireEventList myFireEvents
	AdditionalAudioEvents myAdditionalAudio
	WeaponFeedback myFeedback
	CameraData myCameraData

	WeaponGroups myWeaponGroup AssaultRifle < tooltip="Specifies the type of weapon group this weapon belongs to." >
	WeaponGroups myAnimationWeaponGroup NotSet < tooltip="Specifies the type of weapon group animations this weapon will use, NotSet will use the regular WeaponGroup value." >
	WeaponEquipmentType myWeaponEquipmentType Main < tooltip="Causes the weapon to be equipped as a sidearm/grenade etc. in the inventory/equip screens and in weapon switches. Still uses weapon group for everything else." >
	WeaponIdentifiers myWeaponIdentifier FNSCAR_L < tooltip="specifies which weaponModel this weapon has." >
	
	CurrencyDefinition* myAmmoCurrency < tooltip="The currency to use as ammo." >

	DetectionSoundType* myDetectionSoundType
	DetectionSoundType* myDetectionImpactSoundType < tooltip="Bullet Impact type will be used if null" >
	
	WeaponSwayData myWeaponSwayData
	
	WeaponScopeData myWeaponScopeData
	bool myBoltCharge false < tooltip="Forces the camera out of scoped mode after firing. Meant to be set for bolt action rifles." >
	
	WeaponHandlingTypes myHandlingType Normal < tooltip="This type controls locomotion and camera restrictions, as an example, heavy weapon handling removes the ability to take cover or sprint." >
	
	float myAimFovChange 0.0 < tooltip="Fov offset to add when player has the weapon shouldered in degrees" >
	float myAimZoomFovChange -12 < tooltip="Fov offset to add when player use weapon zoom in degrees" >
	
	float myThreatPerBullet 100.0 < tooltip="Threat per bullet hitting the detection hitbox" >
	
	float myWeaponSwitchSpeedMultiplier 1.0 < tooltip="Multiplier to change the speed of both holster and draw animations" >

	float myStaggerDamageModifier 1.0 < tooltip="Multiplier that modifies how much stagger is done" >
	float myPVPDamageModifier 1.0 < tooltip="Multiplier that modifies how much damage is done when one agent attacks another" >
	
	int myHipFireDrawTransitionDurationMS 200
	int myAimingDrawTransitionDurationMS 100
	
	int mySpreadIncreaseTimeMS 100 < tooltip="This value determines how long a weapon spread should increase after a round has been fired" >
	int myStartAimSpreadTimeMS 100 < tooltip="This value determines how long a weapon spread should increase after player start aiming" >
	int myStartAimInCoverSpreadTimeMS 100 < tooltip="This value determines how long a weapon spread should increase after player start aiming from cover" >
	
	int myTimeToMinAccuracyMS 500 < tooltip="Blend time it takes to get to Max Spread in milliseconds (Growth while firing)" >
	int myTimeToMaxAccuracyMS 1000 < tooltip="Blend time it takes to get to Min Spread in milliseconds (Shrink while not firing)" >
	
	float mySpreadMin 0.0 < tooltip="Min Spread Angle in Default Third Person Mode" >
	float mySpreadMax 0.0 < tooltip="Max Spread Angle in Default Third Person Mode" >
	bool mySpreadIsUniform FALSE < tooltip="If checked uses uniform spread for firing from the hip" >
	
	float myCoverSpreadMin 0.0 < tooltip="Min Spread Angle in Default Third Person Mode while in Cover" >
	float myCoverSpreadMax 0.0 < tooltip="Max Spread Angle in Default Third Person Mode while in Cover" >
	bool myCoverSpreadIsUniform FALSE < tooltip="If checked uses uniform spread for blind firing from cover" >
	
	float myAimSpreadMin 0.0 < tooltip="Min Spread Angle in Aim Mode" >
	float myAimSpreadMax 0.0 < tooltip="Max Spread Angle in Aim Mode" >
	bool myAimSpreadIsUniform FALSE < tooltip="If checked uses uniform spread while aiming down the sight (not in cover)" >
	
	float myCoverAimSpreadMin 0.0 < tooltip="Min Spread Angle in Aim Mode while in Cover" >
	float myCoverAimSpreadMax 0.0 < tooltip="Max Spread Angle in Aim Mode while in Cover" >
	bool myCoverAimSpreadIsUniform FALSE < tooltip="If checked uses uniform spread while aiming down the sight in cover" >

	float mySpreadIncreaseSpeed 0.1 < tooltip="How fast the spread adjusts to a larger spread value" >	
	float mySpreadReductionSpeed 0.05 < tooltip="How fast the spread adjusts to a lower spread value" >
	
	float myMovementModifier 1.5 < tooltip="Spread angle multiplier while moving" >
	float myMovementModifierSpeedCap 3.0 < tooltip="The fastest player speed that counts into movement spread." >
	float myMovementSpreadThreshold 0.0 < tooltip="Only speeds above the threshold will count towards spread." >
	float myMovementSpreadAcceleration 6.0 < tooltip="How quickly movement spread increases." >
	float myMovementSpreadDeceleration 6.0 < tooltip="How quickly movement spread decreases." >

	float myAimChangeModifier 2.0 < tooltip="Spread angle multiplier while turning" >
	float myAimChangeSensitivity 1.0 < tooltip="" >
	int myAimChangeAccuracyRecoveryTimeMS 500 < tooltip="Recovery time to adjust the spread after the turning stopped in milliseconds" >

	float myTotalSpreadCapModifier 1.0  < tooltip="Multiplier for the final spread values cap. IE code chooses the smallest spread value between current spread and spread max * myTotalSpreadCapModifier." >
	int myAmountOfAccuracyLockedRounds 0 < tooltip="Determines how many rounds you can firing before accuracy spread kicks in." >
	
	bool myUseAimChangeSpread false < tooltip="Lowers the spread accuracy when moving the aim." >
	bool myUseReverseSpread false < tooltip="The projectile spread will shrink instead of expand while firing." >

	float myAimingLengthScale 1.0 < tooltip="Changes the scale length of animations while the players weapon is shouldered, ie: lower value makes animations faster, higher makes them slower." >
	
	float myAccuracyUI 0.0 < tooltip="Accuracy of the gun 0-100, UI only for weapon modding screen" >
	float myStabilityUI 0.0 < tooltip="Stability of the gun 0-100, UI only for weapon modding screen" >
    
	UIDamageType myUIDamageType Normal < tooltip="Type of primary damage source to show in UI." >
	
	bool myIsDynamicOnBackpack false < tooltip="If this is true, it will be attached to a dynamic slot on the backpack. Only for skills currently" >
}   

list WeaponList
{
	Weapon
}

