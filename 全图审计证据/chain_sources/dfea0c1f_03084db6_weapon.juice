include "hunter/game system data/juice/input/inputactions.juice"
include "hunter/game system data/fruit/input/gameinput.fruit"

TriggerGameAction "[Weapon] Aim"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "Left Trigger L2 Hold Down"
				{
					myInputActionType HoldDown
					myInputAction = LEFT_TRIGGER_L2
				}
				ConditionalInputAction "KB Hold"
				{
					myInputActionType HoldDown
					myInputAction = KB_AIM
				}
			}
		}
		ConditionalGameActionState "Aim Not Toggled"
		{
			myNegate TRUE
			myGameActionState IsAimToggled
		}
		ConditionalGameActionState "Not Rolling"
		{
			myNegate TRUE
			myGameActionState Rolling
		}
		ConditionalGameAction "Not In Social Mode"
		{
			myNegate TRUE
			myGameAction ToggleSocialMode
		}
		ConditionalGameActionState "Aiming Is Allowed"
		{
			myGameActionState AimingIsAllowed
		}
		ConditionalGameActionState "Not Bleeding Out"
		{
			myNegate TRUE
			myGameActionState IsBleedingOut
		}
		ConditionalGameActionState "Not Downed"
		{
			myNegate TRUE
			myGameActionState IsDowned
		}
		ConditionalGameActionState "Not in Safe Zone"
		{
			myNegate TRUE
			myGameActionState IsInSafeZone
		}
		ConditionalGameActionState "Not Falling"
		{
			myNegate TRUE
			myGameActionState IsFalling
		}
		ConditionalGameActionState "Not Landing"
		{
			myNegate TRUE
			myGameActionState IsLanding
		}
		ConditionalGameActionState "Not Staggered (Heavy)"
		{
			myNegate TRUE
			myGameActionState IsKnockedDown
		}
		ConditionalActionGroup "Not Interacting Or Using Mounted Weapon"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalGameActionState "Not Interacting"
				{
					myNegate TRUE
					myGameActionState Interacting
				}
				ConditionalGameActionState "Using Mounted Weapon"
				{
					myGameActionState ControllingObject
				}
			}
		}
		ConditionalGameAction "Not Equip Grenade"
		{
			myNegate TRUE
			myRequireNewInput TRUE
			myGameAction EquipGrenade
		}
		ConditionalGameAction "Not Equip Skill LB"
		{
			myNegate TRUE
			myRequireNewInput TRUE
			myGameAction EquipSkillLB
		}
		ConditionalGameAction "Not Equip Skill RB"
		{
			myNegate TRUE
			myRequireNewInput TRUE
			myGameAction EquipSkillRB
		}
	}
	myGameAction Aim
}

TriggerGameAction "[Weapon] Aim Toggle Gamepad"
{
	myConditionalInputActions
	{
		ConditionalInputAction "GP Toggle"
		{
			myInputActionType Pressed
			myToggle TRUE
			myClearToggle TRUE
			myInputAction = LEFT_TRIGGER_L2
		}
		ConditionalInputAction "Not KB Pressed"
		{
			myInputActionType Pressed
			myNegate TRUE
			myInputAction = KB_AIM
		}
		ConditionalGameAction "Not Aim Toggle KP"
		{
			myNegate TRUE
			myWasActive TRUE
			myGameAction AimToggleKB
		}
		ConditionalGameActionState Toggled
		{
			myGameActionState IsAimToggled
		}
		ConditionalGameActionState "Not Rolling"
		{
			myNegate TRUE
			myGameActionState Rolling
		}
		ConditionalGameAction "Not In Social Mode"
		{
			myNegate TRUE
			myGameAction ToggleSocialMode
		}
		ConditionalGameActionState "Aiming Is Allowed"
		{
			myGameActionState AimingIsAllowed
		}
		ConditionalGameActionState "Not Bleeding Out"
		{
			myNegate TRUE
			myGameActionState IsBleedingOut
		}
		ConditionalGameActionState "Not Downed"
		{
			myNegate TRUE
			myGameActionState IsDowned
		}
		ConditionalGameActionState "Not In Vertical Navigation"
		{
			myNegate TRUE
			myGameActionState UsingNavigation
		}
		ConditionalGameActionState "Not in Safe Zone"
		{
			myNegate TRUE
			myGameActionState IsInSafeZone
		}
		ConditionalGameActionState "Not Falling"
		{
			myNegate TRUE
			myGameActionState IsFalling
		}
		ConditionalGameActionState "Not Landing"
		{
			myNegate TRUE
			myGameActionState IsLanding
		}
		ConditionalGameActionState Alive
		{
			myGameActionState IsAlive
		}
		ConditionalGameAction "Not Equipping Skill LB"
		{
			myNegate TRUE
			myRequireNewInput FALSE
			myGameAction EquipSkillLB
		}
		ConditionalGameAction "Not Equipping Skill RB"
		{
			myNegate TRUE
			myRequireNewInput FALSE
			myGameAction EquipSkillRB
		}
		ConditionalGameAction "Not Equipping Grenade"
		{
			myNegate TRUE
			myRequireNewInput FALSE
			myGameAction EquipGrenade
		}
	}
	myGameAction AimToggleGP
}

