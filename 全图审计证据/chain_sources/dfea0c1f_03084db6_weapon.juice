TriggerGameAction "Aim Toggle"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalGameAction "Aim Toggle KB"
				{
					myGameAction AimToggleKB
				}
				ConditionalGameAction "Aim Toggle GP"
				{
					myGameAction AimToggleGP
				}
			}
		}
	}
	myGameAction Aim
}

