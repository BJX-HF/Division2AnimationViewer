TriggerGameAction "[Weapon] ReloadOnRelease"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "X Pressed"
				{
					myInputActionType ReleaseBeforeTime
					myTimer 300
					myInputAction = X_SQUARE
				}
				ConditionalInputAction "KB Pressed"
				{
					myInputActionType ReleaseBeforeTime
					myTimer 300
					myInputAction = KB_RELOAD
				}
			}
		}
		ConditionalGameAction "Not In Social Mode"
		{
			myNegate TRUE
			myGameAction ToggleSocialMode
		}
		ConditionalGameActionState "Not Rolling"
		{
			myNegate TRUE
			myGameActionState Rolling
		}
		ConditionalGameActionState "Not Bleeding Out"
		{
			myNegate TRUE
			myGameActionState IsBleedingOut
		}
		ConditionalGameActionState "Not Downed"
		{
			myNegate TRUE
			myGameActionState IsDowned
		}
		ConditionalGameActionState "Not Interacting"
		{
			myNegate TRUE
			myGameActionState Interacting
		}
		ConditionalGameActionState "Not In Safe Zone"
		{
			myNegate TRUE
			myGameActionState IsInSafeZone
		}
		ConditionalGameActionState "Not Falling"
		{
			myNegate TRUE
			myGameActionState IsFalling
		}
		ConditionalGameActionState "Not Landing"
		{
			myNegate TRUE
			myGameActionState IsLanding
		}
		ConditionalGameActionState "Is using gamepad"
		{
			myGameActionState IsUsingGamepad
		}
	}
	myGameAction Reload
}

TriggerGameAction "[Weapon] ReloadOnPress"
{
	myConditionalInputActions
	{
		ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalInputAction "X Square"
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = X_SQUARE
				}
				ConditionalInputAction "KB Pressed"
				{
					myInputActionType Pressed
					myTimer 0
					myInputAction = KB_RELOAD
				}
			}
		}
		ConditionalGameAction "Not In Social Mode"
		{
			myNegate TRUE
			myGameAction ToggleSocialMode
		}
		ConditionalGameActionState "Not Rolling"
		{
			myNegate TRUE
			myGameActionState Rolling
		}
		ConditionalGameActionState "Not Bleeding Out"
		{
			myNegate TRUE
			myGameActionState IsBleedingOut
		}
		ConditionalGameActionState "Not Downed"
		{
			myNegate TRUE
			myGameActionState IsDowned
		}
		ConditionalGameAction "Not in interact"
		{
			myNegate TRUE
			myGameAction Interact
		}
		ConditionalActionGroup "Check for interaction available if using gamepad"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup "Check for interaction available if using gamepad"
				{
					myConditionalInputActions
					{
						ConditionalGameActionState "Not Can Interact"
						{
							myNegate TRUE
							myGameActionState CanInteractExcludingNavAndDisabled
						}
						ConditionalGameActionState "Not Can Start Extraction"
						{
							myNegate TRUE
							myGameActionState CanStartExtraction
						}
						ConditionalGameActionState "Not Can Interact With Extraction Rope"
						{
							myNegate TRUE
							myGameActionState CanInteractWithExtractionRope
						}
						ConditionalGameActionState "Not Can Loot"
						{
							myNegate TRUE
							myGameActionState CanLoot
						}
					}
				}
				ConditionalGameActionState "Is using gamepad"
				{
					myNegate TRUE
					myGameActionState IsUsingGamepad
				}
			}
		}
		ConditionalGameActionState "Not In Safe Zone"
		{
			myNegate TRUE
			myGameActionState IsInSafeZone
		}
		ConditionalGameActionState "Not Falling"
		{
			myNegate TRUE
			myGameActionState IsFalling
		}
		ConditionalGameActionState "Not Landing"
		{
			myNegate TRUE
			myGameActionState IsLanding
		}
	}
	myGameAction Reload
}

