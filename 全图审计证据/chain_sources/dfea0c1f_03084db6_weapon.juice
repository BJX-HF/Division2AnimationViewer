TriggerGameAction "[Weapon] Melee Push"
{
	myConditionalInputActions
	{
	ConditionalActionGroup "Input Actions"
		{
			myOperator Or
			myConditionalInputActions
			{
				ConditionalActionGroup Default
				{
					myOperator And
					myConditionalInputActions
					{
						ConditionalActionGroup "Input Actions"
						{
							myOperator Or
							myConditionalInputActions
							{
								ConditionalInputAction "Right Stick Pressed"
								{
									myInputActionType Pressed
									myInputAction = RIGHT_STICK_BUTTON
								}
								ConditionalInputAction "KB Pressed"
								{
									myInputActionType Pressed
									myInputAction = KB_ZOOM
								}
							}
						}
						ConditionalGameActionState CanLoot
						{
							myNegate TRUE
							myGameActionState CanLoot
						}
					}
				}
				ConditionalActionGroup NearbyLoot
				{
					myOperator And
					myConditionalInputActions
					{
						ConditionalActionGroup "Input Actions"
						{
							myOperator Or
							myConditionalInputActions
							{
								ConditionalInputAction "Right Stick Release"
								{
									myInputActionType ReleaseBeforeTime
									myTimer 300
									myInputAction = RIGHT_STICK_BUTTON
								}
								ConditionalInputAction "KB Tab Released"
								{
									myInputActionType ReleaseBeforeTime
									myTimer 300
									myInputAction = KB_ZOOM
								}
							}
						}
						ConditionalGameActionState CanLoot
						{
							myGameActionState CanLoot
						}
					}
				}
			}
		}
		ConditionalGameActionState "Not Aiming"
		{
			myNegate TRUE
			myGameActionState Aiming
		}
		ConditionalGameActionState "Not Staggered"
		{
			myNegate TRUE
			myGameActionState IsStaggered
		}
		ConditionalGameActionState "Not in Safe Zone"
		{
			myNegate TRUE
			myGameActionState IsInSafeZone
		}
		ConditionalGameActionState "Not in HUB"
		{
			myNegate TRUE
			myGameActionState IsInHUB
		}
		ConditionalGameActionState "Melee Push Not prevented"
		{
			myNegate TRUE
			myGameActionState IsMeleePushPrevented
		}
		ConditionalGameActionState "Not In Weapon Switch"
		{
			myNegate TRUE
			myGameActionState IsInWeaponSwitch
		}
		ConditionalGameActionState "Not In Throwable Skill Mode"
		{
			myNegate TRUE
			myGameActionState IsInThrowableSkillModeAny
		}
	}
	myGameAction MeleePush
}

